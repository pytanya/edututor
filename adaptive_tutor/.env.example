# Модели и провайдеры LLM (регион задаёт основного)
TUTOR_LLM_PRIMARY_PROVIDER=
#   пусто — по региону: RU -> routerai, GLOBAL -> openrouter; второй шлюз
#   подключается автоматически как фолбек, если задан его ключ
TUTOR_LLM_PLANNER_MODEL=
#   модель planner (пусто — дефолт региона; для RU это qwen/qwen3.7-flash, как
#   в референсе project_work; instruct без reasoning)
TUTOR_LLM_FAST_MODEL=
TUTOR_LLM_JUDGE_MODEL=
TUTOR_LLM_RETRIES=2
#   доп. попытки при временных ошибках (429/5xx/сеть/таймаут), экспоненциальный backoff
TUTOR_LLM_TIMEOUT_SEC=120
#   таймаут одного LLM-запроса
TUTOR_LLM_FALLBACK_MODELS=
#   фолбек-модели для planner/fast через запятую (пусто — дефолт региона)
TUTOR_LLM_JUDGE_FALLBACK_MODELS=
#   фолбек-модели для judge через запятую (пусто — дефолт региона)
TUTOR_LLM_RETRY_EMPTY=true
#   пустой ответ (без tool_calls) считать ошибкой и пробовать следующего кандидата
TUTOR_LLM_MAX_TOKENS=4096
#   макс. токенов ответа planner (полный урок в JSON-конверте может быть длинным;
#   маленький лимит обрезает JSON посреди «text» и ломает парсинг конверта)

# Регион: RU или GLOBAL
TUTOR_REGION=GLOBAL

# RouterAI (для региона RU)
TUTOR_ROUTERAI_API_KEY=
TUTOR_ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# OpenRouter (для региона GLOBAL)
TUTOR_OPENROUTER_API_KEY=
TUTOR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Yandex Cloud Search API v2 (для региона RU): API-ключ + folderId каталога
TUTOR_YANDEX_API_KEY=
TUTOR_YANDEX_FOLDER_ID=
TUTOR_YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search

# Tavily Search (для региона GLOBAL)
TUTOR_TAVILY_API_KEY=

# DuckDuckGo (fallback)
TUTOR_DDGS_ENABLED=true

# Qdrant
TUTOR_QDRANT_URL=http://localhost:6333
TUTOR_QDRANT_COLLECTION=adaptive_tutor

# Эмбеддинги
#   local — локальный sentence-transformers (нужен torch, ~2 ГБ);
#   api    — OpenAI-совместимый /embeddings RouterAI (без torch; нужен
#            TUTOR_ROUTERAI_API_KEY). Для api задайте модель-аналог, например
#            intfloat/multilingual-e5-large или baai/bge-m3.
TUTOR_EMBEDDING_PROVIDER=local
TUTOR_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Профиль ученика (SQLite)
TUTOR_STUDENT_DB_PATH=data/students.db

# Граф знаний (E2)
TUTOR_KNOWLEDGE_GRAPH_DIR=data/knowledge_graphs
TUTOR_GRAPH_SCHEMA_VERSION=1
TUTOR_ONTOLOGY_MAX_VERTICES=14
TUTOR_MASTERY_MASTERED_THRESHOLD=0.8
TUTOR_MASTERY_MASTERED_ATTEMPTS=3

# Интервальные повторения (SM-2)
TUTOR_REVIEW_ENABLED=true
TUTOR_REVIEW_QUIZ_SIZE=5
TUTOR_REVIEW_BANK_MAX_CARDS=200

# Knowledge Wiki и экспорт (E4)
TUTOR_KNOWLEDGE_WIKI_DIR=data/knowledge_wiki
TUTOR_OKF_DIR=data/okf
TUTOR_WIKI_ENABLED=true
TUTOR_WIKI_ENRICH_ENABLED=true

# Безопасность
TUTOR_MAX_LLM_CALLS_PER_SESSION=50
TUTOR_MAX_COST_PER_SESSION_USD=1.0
TUTOR_CIRCUIT_BREAKER_THRESHOLD=3
TUTOR_CIRCUIT_BREAKER_TIMEOUT=30

# Агент
TUTOR_MAX_AGENT_STEPS=6
TUTOR_MAX_AGENT_TIME_SEC=150

# LinUCB-советник сложности (Этап 5)
TUTOR_BANDIT_ENABLED=true
TUTOR_BANDIT_ALPHA=0.6

# Логирование
TUTOR_LOG_LEVEL=INFO
TUTOR_LOG_FILE=logs/agent.jsonl
